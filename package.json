{
  "name": "newspulse",
  "version": "1.0.0",
  "private": true,
  "description": "NewsPulse — news-driven multi-asset trading agent for Binance Agent OS Mini Hackathon 2026 (Track A)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "demo": "node --import tsx --import ./scripts/baw-bridge.mjs src/cli/demo.ts",
    "cli": "node --import tsx --import ./scripts/baw-bridge.mjs src/cli/index.ts",
    "agent:once": "node --import tsx --import ./scripts/baw-bridge.mjs src/cli/index.ts once",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "live": "node --import tsx --import ./scripts/baw-bridge.mjs src/cli/demo.ts",
    "judge": "node --import tsx --import ./scripts/baw-bridge.mjs src/cli/demo.ts --judge",
    "judge:fixture": "NEWSPULSE_MODE=paper NEWSPULSE_DATA=fixture node --import tsx --import ./scripts/baw-bridge.mjs src/cli/demo.ts --judge --fixture",
    "test": "node --import tsx --test src/test/*.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
