# NewsPulse configuration
# Paper/sim is the default. Agent OS MCP uses OAuth — do NOT put Binance API secret keys here.

# Mode: paper | mock | live (live requires MCP host OAuth / hub; still needs trade confirmation)
NEWSPULSE_MODE=paper

# Binance Agent OS MCP (CEX / agentic)
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=grok

# Binance Wallet Agentic Hub (BAW / on-chain)
BINANCE_BAW_HUB_URL=https://web3.binance.com/agentic-hub

# Risk limits
MAX_POSITION_USD=2500
MAX_DAILY_TRADES=20
TRADE_COOLDOWN_MS=15000
MAX_CONCENTRATION_PCT=35
KILL_SWITCH=false

# Starting paper cash (USDT)
PAPER_CASH_USDT=100000

# Scoring thresholds
BUY_SCORE_THRESHOLD=0.45
SELL_SCORE_THRESHOLD=-0.45
