# NewsPulse configuration
# Live is the default. Agent OS MCP uses OAuth — do NOT put Binance API secret keys here.

NEWSPULSE_MODE=live
NEWSPULSE_DATA=auto
ALLOW_SIMULATED_PREMIUM=0
NEWSPULSE_BAW_ALLOW_SPEND=0

BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=grok
BINANCE_BAW_HUB_URL=https://web3.binance.com/agentic-hub

# Optional MCP host bridge (no secrets in repo)
NEWSPULSE_MCP_BRIDGE=auto
# NEWSPULSE_MCP_SESSION_FILE=
# NEWSPULSE_MCP_WRAPPER=
# GROK_MCP_USE_TOOL=

# Optional premium merchant that returns HTTP 402
# NEWSPULSE_PREMIUM_URL=

# BAW_BIN=/home/box/.local/bin/baw

MAX_POSITION_USD=2500
MAX_DAILY_TRADES=20
TRADE_COOLDOWN_MS=15000
MAX_CONCENTRATION_PCT=35
KILL_SWITCH=false
PAPER_CASH_USDT=100000
BUY_SCORE_THRESHOLD=0.45
SELL_SCORE_THRESHOLD=-0.45
PREMIUM_SIGNAL_USD=2
PREMIUM_LOW_CONFIDENCE=0.42
